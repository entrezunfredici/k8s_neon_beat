# =============================================================================
# Secret Cloudflare API Token - cert-manager DNS01
#
# Template only. Do not commit a real token.
#
# Required Cloudflare token permissions:
#   Zone / DNS / Edit
#   Zone / Zone / Read if required by your account setup
#
# Encode the token:
#   echo -n "YOUR_CLOUDFLARE_TOKEN" | base64
#
# Replace the placeholder value below before applying.
# =============================================================================

apiVersion: v1
kind: Secret
metadata:
  name: cloudflare-api-token
  namespace: cert-manager
type: Opaque
data:
  # base64("change-me") - replace before real use.
  api-token: Y2hhbmdlLW1l
